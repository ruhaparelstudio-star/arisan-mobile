EXPO_PUBLIC_APP_ENV=development

# API — ganti dengan IP LAN kamu: ifconfig (Mac/Linux) atau ipconfig (Windows)
EXPO_PUBLIC_API_URL=http://192.168.x.x:3001

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# App Links
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://arisan.app/privacy
EXPO_PUBLIC_SUPPORT_WA=62xxxxxxxxxx
EXPO_PUBLIC_PLAYSTORE_URL=https://play.google.com/store/apps/details?id=com.ruhaparelstudio.arisan
